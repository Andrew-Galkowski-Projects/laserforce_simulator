# Copy to .env.selfhost (git-ignored) and fill in. See docs/self-hosting.md.

# --- Tailscale Funnel ---
# Auth key from https://login.tailscale.com/admin/settings/keys. It is used only
# on first boot; the node identity then lives in the tsstate volume.
TS_AUTHKEY=tskey-auth-REPLACE-ME
# The public URL becomes https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_HOSTNAME=laserforce

# --- Django ---
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=REPLACE-ME
DEBUG=False
# Your Funnel hostname, e.g. laserforce.tail1234.ts.net, plus localhost for the loopback port.
ALLOWED_HOSTS=laserforce.REPLACE-ME.ts.net,localhost,127.0.0.1

# --- Postgres (the compose file builds DATABASE_URL from this) ---
POSTGRES_PASSWORD=REPLACE-ME

# --- Optional: Cloudflare R2 media storage (falls back to the local filesystem) ---
# R2_BUCKET_NAME=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_ENDPOINT_URL=
# R2_PUBLIC_URL=
