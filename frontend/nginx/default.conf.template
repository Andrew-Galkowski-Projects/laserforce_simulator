# ANG-07 (ADR-0046): the SPA at /app/, everything else proxied to Django.
# Rendered by the nginx image's envsubst: only ${DJANGO_UPSTREAM}, ${NGINX_PORT}
# and ${NGINX_LOCAL_RESOLVERS} are filled in; nginx's own $variables are left alone.

# Keep https from Tailscale Funnel (or any TLS proxy in front); else our own scheme.
# The header is trusted from the first hop: Tailscale's proxy rewrites it, and the dev
# stack is local-only (Django's own published :8000 trusted it already).
map $http_x_forwarded_proto $lf_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen ${NGINX_PORT};
    server_name _;

    # Map uploads: nginx's 1 MB default would 413 them, Django sets no file limit.
    client_max_body_size 20m;

    # Relative Location headers, so redirects keep the published host port.
    absolute_redirect off;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    root /usr/share/nginx/html;

    location = /app {
        return 301 /app/;
    }

    location /app/ {
        try_files $uri $uri/ /app/index.html;
    }

    # Always revalidated, so a deploy's new bundle names are picked up.
    location = /app/index.html {
        add_header Cache-Control "no-cache";
    }

    # outputHashing "all": every bundle, stylesheet and font name carries a hash.
    location ~* ^/app/.+\.(?:js|css|woff2?)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The container's own DNS (from /etc/resolv.conf: Docker's 127.0.0.11 under
    # compose), asked per request because proxy_pass uses a variable: a recreated
    # app container's new IP is picked up instead of a 502.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location / {
        set $django_upstream ${DJANGO_UPSTREAM};
        proxy_pass http://$django_upstream;
        # $http_host keeps the port, so Django's CSRF Origin check matches.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $lf_forwarded_proto;
    }
}
